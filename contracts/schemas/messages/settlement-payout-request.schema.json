{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bluepay.local/messages/settlement-payout-request.schema.json",
  "title": "SettlementPayoutRequest",
  "type": "object",
  "required": ["eventType", "eventVersion", "sourceService", "messageId", "correlationId", "reference", "transferReference", "createdAt", "payload"],
  "properties": {
    "eventType": { "type": "string", "const": "OUTFLOW_SETTLEMENT_REQUESTED" },
    "eventVersion": { "type": "string" },
    "sourceService": { "type": "string", "const": "bluepay" },
    "messageId": { "type": "string" },
    "correlationId": { "type": "string" },
    "reference": { "type": "string" },
    "transferReference": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["batchReference", "settlementReference", "settlementDate", "grossAmount", "feeAmount", "netAmount", "merchantId", "currency", "itemCount", "items", "instructionType", "status", "idempotencyKey"],
      "properties": {
        "batchId": { "type": ["integer", "null"] },
        "batchReference": { "type": "string" },
        "settlementReference": { "type": "string" },
        "payoutGroupReference": { "type": ["string", "null"] },
        "settlementDate": { "type": "string" },
        "merchantId": { "type": "string" },
        "currency": { "type": "string" },
        "grossAmount": { "type": ["number", "string"] },
        "feeAmount": { "type": ["number", "string"] },
        "netAmount": { "type": ["number", "string"] },
        "amountToSend": { "type": ["number", "string"] },
        "merchantCount": { "type": "integer" },
        "itemCount": { "type": "integer" },
        "accNumber": { "type": ["string", "null"] },
        "beneficiaryBankCode": { "type": ["string", "null"] },
        "beneficiaryAccountName": { "type": ["string", "null"] },
        "payoutAccountReference": { "type": ["string", "null"] },
        "instructionType": { "type": "string", "const": "SETTLEMENT" },
        "status": { "type": "string" },
        "idempotencyKey": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["transactionReference", "grossAmount", "feeAmount", "netAmount", "status"],
            "properties": {
              "idempotencyKey": { "type": "string" },
              "merchantId": { "type": "string" },
              "transactionId": { "type": ["integer", "string"] },
              "transactionReference": { "type": "string" },
              "grossAmount": { "type": ["number", "string"] },
              "feeAmount": { "type": ["number", "string"] },
              "netAmount": { "type": ["number", "string"] },
              "currency": { "type": "string" },
              "payoutGroupReference": { "type": ["string", "null"] },
              "status": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
